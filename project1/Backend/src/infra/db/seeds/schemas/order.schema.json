{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "CafeOrder",
  "description": "Structured representation of a cafe or restaurant order extracted from free text.",
  "properties": {
    "order_type": {
      "type": ["string", "null"],
      "enum": ["dine_in", "takeaway", "delivery", null],
      "description": "How the order will be fulfilled."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "List of ordered items.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the item ordered."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantity of the item."
          },
          "modifiers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Customizations or modifiers for the item (e.g. no sugar, extra milk)."
          }
        },
        "required": ["name", "quantity"],
        "additionalProperties": false
      }
    },
    "payment_method": {
      "type": ["string", "null"],
      "enum": ["cash", "card", "unknown", null],
      "description": "Payment method if mentioned."
    },
    "customer_name": {
      "type": ["string", "null"],
      "description": "Name of the customer if provided."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Additional order notes or instructions."
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
