// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  apikey    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extractions       AIExtraction[]
  ExtractionSession ExtractionSession[]
  usageCounter      usageCounter[]
  UsageCost         UsageCost[]
}

model ExtractionSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  lastExtractionId String?
  createdAt        DateTime @default(now())

  extractions AIExtraction[]
}

model AIExtraction {
  id        String            @id @default(uuid())
  sessionId String
  session   ExtractionSession @relation(fields: [sessionId], references: [id])

  version       Int
  inputText     String
  extractedData Json
  attempts      Int
  status        ExtractionStatus
  model         String
  tokensIn      Int
  tokenOut      Int
  createdAt     DateTime         @default(now())
  User          User?            @relation(fields: [userId], references: [id])
  userId        String?

  @@unique([sessionId, version])
}

model usageCounter {
  id     String @id @default(uuid())
  userId String
  window String // e.g. "2026-01-28T11"
  type   String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, window, type])
}

model UsageCost {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  sessionId    String?
  extractionId String?
  model        String
  tokensIn     Int
  tokensOut    Int
  createdAt    DateTime @default(now())
}


enum ExtractionStatus {
  success
  failed
}
